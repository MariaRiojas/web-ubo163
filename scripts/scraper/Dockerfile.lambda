# Scraper CGBVP — Lambda container (Node.js 20 + @sparticuz/chromium)
FROM public.ecr.aws/lambda/nodejs:20

WORKDIR ${LAMBDA_TASK_ROOT}

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    HEADLESS=1 \
    NODE_ENV=production \
    AWS_NODEJS_CONNECTION_REUSE_ENABLED=1

RUN echo '{"name":"scraper","type":"module","private":true}' > package.json

# Chromium
RUN npm install @sparticuz/chromium puppeteer-core

# Resto de dependencias
RUN npm install tsx@4 @aws-sdk/client-dynamodb @aws-sdk/lib-dynamodb @aws-sdk/client-secrets-manager cheerio \
    && npm cache clean --force

# Código fuente
COPY lib/db/dynamodb.ts lib/db/dynamodb.ts
COPY lib/db/schema/ lib/db/schema/
COPY lib/cgbvp/ lib/cgbvp/
COPY scripts/scraper/ scripts/scraper/
COPY company.config.ts tsconfig.json ./

# NODE_OPTIONS al final (tsx ya está instalado)
ENV NODE_OPTIONS="--import=tsx/esm"

CMD ["scripts/scraper/index.handler"]

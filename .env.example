# ================================================================
# CUARTEL-CRM — Variables de Entorno (Serverless / DynamoDB)
# Copiar este archivo como .env.local y completar los valores
# ================================================================

# ── DynamoDB ─────────────────────────────────────────────────────
# Prefijo de tablas — debe coincidir con resourcePrefix en cdk.json
TABLE_PREFIX=ubo163-dev
AWS_REGION=us-east-1

# Credenciales AWS para desarrollo local (en Lambda se usa el IAM role)
# Opción A: perfil configurado en ~/.aws/credentials
# AWS_PROFILE=manbuild
# Opción B: claves explícitas (no recomendado, usar solo en dev puntual)
# AWS_ACCESS_KEY_ID=AKIAxxx
# AWS_SECRET_ACCESS_KEY=xxx

# ── Autenticación (NextAuth v5) ──────────────────────────────────
# Generar con: openssl rand -hex 32
AUTH_SECRET=your-secret-key-min-32-chars-replace-this
AUTH_URL=http://localhost:3000

# ── Almacenamiento S3 ────────────────────────────────────────────
# Producción: se pasa automáticamente como env var en la Lambda (via CDK)
# Desarrollo local: puede apuntar a MinIO o a S3 directamente
S3_BUCKET=ubo163-dev-media
S3_REGION=us-east-1
# Solo para dev local con MinIO:
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000/ubo163-dev-media

# ── Correo Electrónico (SMTP) ─────────────────────────────────────
# Desarrollo: Mailpit (docker compose up -d mailpit) → UI en http://localhost:8025
# Producción: SES SMTP (env var inyectada por CDK, credenciales en Secrets Manager)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="CUARTEL-CRM <sistema@bomberos163.pe>"
# SMTP_USER=
# SMTP_PASS=

# ── Scraper CGBVP ────────────────────────────────────────────────
# Token de autenticación para el endpoint /api/sync (compartido con el scraper Lambda)
SCRAPPER_SYNC_SECRET=your-secret-token-here

# Credenciales de la extranet CGBVP (para el scraper Lambda)
USUARIO_INTRANET=tu_usuario_cgbvp
CONTRASENA_INTRANET=tu_contrasena_cgbvp
HEADLESS=1
SCRAPER_HEALTH_PORT=8080

# ── Secretos en producción (Lambda los lee de Secrets Manager) ───
# APP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...
# SES_SMTP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...
# SCRAPPER_SYNC_TOKEN_ARN=arn:aws:secretsmanager:us-east-1:...
# CGBVP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...
